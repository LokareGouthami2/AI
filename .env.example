# Copy to .env and fill in. Never commit .env. Keys stay on the server only.

# --- LLM (optional) ---------------------------------------------------------
# Without a key WriteAI runs its offline extractive engine for every AI feature.
ANTHROPIC_API_KEY=
# auto | anthropic | mock
WRITEAI_LLM_PROVIDER=auto
WRITEAI_ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
WRITEAI_ANTHROPIC_EFFORT=medium
# Server-side refusal fallbacks (beta)
WRITEAI_ANTHROPIC_FALLBACKS=true

# --- Embeddings ---------------------------------------------------------------
# auto: sentence-transformers if installed & cached (requirements-embeddings.txt),
# otherwise the deterministic hashing embedder.
WRITEAI_EMBEDDING_BACKEND=auto

# --- Storage ------------------------------------------------------------------
WRITEAI_DATA_DIR=./data
# WRITEAI_DATABASE_URL=postgresql+psycopg://user:pass@host/writeai

# --- Limits & API -------------------------------------------------------------
WRITEAI_MAX_UPLOAD_MB=20
WRITEAI_MAX_PAGES=300
WRITEAI_RATE_LIMIT_PER_MINUTE=60
# Optional shared token for a public demo (clients send X-API-Token)
WRITEAI_API_TOKEN=
WRITEAI_CORS_ORIGINS=["http://localhost:5173"]
