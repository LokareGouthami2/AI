{
  "name": "WriteAI 2.0",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "postCreateCommand": "scripts/setup.sh",
  "postStartCommand": "scripts/dev.sh",
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": { "label": "WriteAI web", "onAutoForward": "openBrowser" },
    "8000": { "label": "WriteAI API", "onAutoForward": "silent" }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python", "charliermarshall.ruff", "dbaeumer.vscode-eslint"] }
  }
}
